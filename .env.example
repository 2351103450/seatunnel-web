# Frontend Nginx image
SEATUNNEL_WEB_IMAGE=seatunnel-web:latest

# Backend image
SEATUNNEL_WEB_API_IMAGE=seatunnel-web-api:latest

# Browser access port
SEATUNNEL_WEB_PORT=9527

# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=seatunnel_web
MYSQL_USER=seatunnel
MYSQL_PASSWORD=change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306

# JVM
JAVA_OPTS=-Xms512m -Xmx1024m

# Spring Boot additional arguments
APP_OPTS=

# Master key used to AES-GCM encrypt datasource passwords. Replace before production use.
SEATUNNEL_WEB_DATASOURCE_MASTER_KEY=change_me
